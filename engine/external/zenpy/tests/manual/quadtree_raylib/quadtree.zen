# ZenPy quadtree demo. Everything lives here: points, nodes, insert, queries.
# Per frame: move points, rebuild the tree (fresh nodes), one neighbour
# query per point, one rectangle query around the mouse, draw.

CAPACITY = 8
MAX_DEPTH = 8
RADIUS = 6
MOUSE_W = 160
MOUSE_H = 120

class Point:
    def __init__(self, x, y, vx, vy):
        self.x = x
        self.y = y
        self.vx = vx
        self.vy = vy
        self.color = 0

class Node:
    x: float = 0.0
    y: float = 0.0
    w: float = 0.0
    h: float = 0.0
    depth: int = 0
    count: int = 0
    split: bool = False
    pts: Array[Point]
    c0: Node?
    c1: Node?
    c2: Node?
    c3: Node?

    def __init__(self, x, y, w, h, depth):
        self.x = x
        self.y = y
        self.w = w
        self.h = h
        self.depth = depth
        self.pts = []
        self.count = 0
        self.split = False
        self.c0 = None
        self.c1 = None
        self.c2 = None
        self.c3 = None

    def child_for(self, px, py):
        if py < self.y + self.h * 0.5:
            if px < self.x + self.w * 0.5:
                return self.c0
            return self.c1
        if px < self.x + self.w * 0.5:
            return self.c2
        return self.c3

    def insert(self, p: Point):
        node: Node = self
        while node.split:
            node = node.child_for(p.x, p.y)
        node.pts.append(p)
        node.count += 1
        if node.count > CAPACITY and node.depth < MAX_DEPTH:
            node.subdivide()

    def subdivide(self):
        hw = self.w * 0.5
        hh = self.h * 0.5
        d = self.depth + 1
        self.c0 = Node(self.x, self.y, hw, hh, d)
        self.c1 = Node(self.x + hw, self.y, hw, hh, d)
        self.c2 = Node(self.x, self.y + hh, hw, hh, d)
        self.c3 = Node(self.x + hw, self.y + hh, hw, hh, d)
        self.split = True
        old: Array[Point] = self.pts
        n = self.count
        i = 0
        while i < n:
            p = old[i]
            self.child_for(p.x, p.y).insert(p)
            i += 1
        self.pts = []
        self.count = 0

    def count_in(self, x0, y0, x1, y1):
        # number of points with x0 <= x < x1, y0 <= y < y1
        if x1 <= self.x or y1 <= self.y or x0 >= self.x + self.w or y0 >= self.y + self.h:
            return 0
        if self.split:
            n = self.c0.count_in(x0, y0, x1, y1) + self.c1.count_in(x0, y0, x1, y1)
            n += self.c2.count_in(x0, y0, x1, y1) + self.c3.count_in(x0, y0, x1, y1)
            return n
        n = 0
        pts: Array[Point] = self.pts
        i = 0
        c = self.count
        while i < c:
            p = pts[i]
            if p.x >= x0 and p.x < x1 and p.y >= y0 and p.y < y1:
                n += 1
            i += 1
        return n

    def mark_in(self, x0, y0, x1, y1, color):
        # colour every point inside the rectangle; returns how many
        if x1 <= self.x or y1 <= self.y or x0 >= self.x + self.w or y0 >= self.y + self.h:
            return 0
        if self.split:
            n = self.c0.mark_in(x0, y0, x1, y1, color) + self.c1.mark_in(x0, y0, x1, y1, color)
            n += self.c2.mark_in(x0, y0, x1, y1, color) + self.c3.mark_in(x0, y0, x1, y1, color)
            return n
        n = 0
        pts: Array[Point] = self.pts
        i = 0
        c = self.count
        while i < c:
            p = pts[i]
            if p.x >= x0 and p.x < x1 and p.y >= y0 and p.y < y1:
                p.color = color
                n += 1
            i += 1
        return n

    def draw(self):
        # node bounds; returns the number of nodes
        draw_rect(self.x, self.y, self.w, self.h, 3)
        if not self.split:
            return 1
        return 1 + self.c0.draw() + self.c1.draw() + self.c2.draw() + self.c3.draw()

points = []
W = screen_width()
H = screen_height()

def add_points(n, x, y):
    i = 0
    while i < n:
        if x < 0:
            points.append(Point(rand(0, W), rand(0, H), rand(-60, 60), rand(-60, 60)))
        else:
            points.append(Point(x, y, rand(-60, 60), rand(-60, 60)))
        i += 1

def update_all(dt):
    pts: Array[Point] = points
    n = len(points)
    root: Node = Node(0, 0, W, H, 0)

    # move + rebuild
    i = 0
    while i < n:
        p = pts[i]
        p.x += p.vx * dt
        p.y += p.vy * dt
        if p.x < 0:
            p.x = 0
            p.vx = -p.vx
        elif p.x >= W:
            p.x = W - 1
            p.vx = -p.vx
        if p.y < 0:
            p.y = 0
            p.vy = -p.vy
        elif p.y >= H:
            p.y = H - 1
            p.vy = -p.vy
        p.color = 0
        root.insert(p)
        i += 1

    # broad phase: a neighbour within RADIUS (the point itself counts once)
    neighbours = 0
    i = 0
    while i < n:
        p = pts[i]
        if root.count_in(p.x - RADIUS, p.y - RADIUS, p.x + RADIUS, p.y + RADIUS) > 1:
            p.color = 1
            neighbours += 1
        i += 1

    # mouse rectangle
    mx = mouse_x() - MOUSE_W * 0.5
    my = mouse_y() - MOUSE_H * 0.5
    hits = root.mark_in(mx, my, mx + MOUSE_W, my + MOUSE_H, 2)

    nodes = root.draw()
    draw_rect(mx, my, MOUSE_W, MOUSE_H, 2)
    i = 0
    while i < n:
        p = pts[i]
        draw_point(p.x, p.y, p.color)
        i += 1
    set_stats(nodes, neighbours, hits)
