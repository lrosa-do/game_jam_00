# ZenPy bunnymark script. Same shape in every language: a Bunny class with
# x/y/vx/vy, an update(dt) method that moves, bounces and calls the native
# draw, a module-level list, add_bunnies(n) and update_all(dt).

class Bunny:
    def __init__(self, x, y, vx, vy):
        self.x = x
        self.y = y
        self.vx = vx
        self.vy = vy

    def update(self, dt):
        self.x = self.x + self.vx * dt
        self.y = self.y + self.vy * dt
        if self.x > max_x or self.x < 0:
            self.vx = -self.vx
        if self.y > max_y or self.y < 0:
            self.vy = -self.vy
        draw_bunny(self.x, self.y)

bunnies = []
max_x = screen_width() - 26
max_y = screen_height() - 37

def add_bunnies(n):
    i = 0
    while i < n:
        b = Bunny(rand(0, max_x), rand(0, max_y), rand(-250, 250), rand(-250, 250))
        bunnies.append(b)
        i = i + 1

def update_all(dt):
    typed: Array[Bunny] = bunnies
    n = len(bunnies)
    i = 0
    while i < n:
        typed[i].update(dt)
        i = i + 1
