#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(set = 0, binding = 0, std140) uniform Params
{
	vec4 time_speed_randomness_wavesize;
}
params;

layout(r32f, set = 3, binding = 0) uniform restrict writeonly image3D wind_image;

const int kSize = 32;

uint wang_hash(uint seed)
{
	seed = (seed ^ 61u) ^ (seed >> 16u);
	seed *= 9u;
	seed = seed ^ (seed >> 4u);
	seed *= 0x27d4eb2du;
	seed = seed ^ (seed >> 15u);
	return seed;
}

float hash_unit(uint h)
{
	return float(h >> 8u) * (1.0 / 16777216.0) * 2.0 - 1.0;
}

vec3 hash_gradient_3d(vec3 p)
{
	uint x = uint(int(p.x));
	uint y = uint(int(p.y));
	uint z = uint(int(p.z));
	uint seed = wang_hash(x * 73856093u ^ y * 19349663u ^ z * 83492791u);
	uint h0 = wang_hash(seed);
	uint h1 = wang_hash(h0);
	uint h2 = wang_hash(h1);
	return vec3(hash_unit(h0), hash_unit(h1), hash_unit(h2));
}

float noise_gradient_3d(vec3 p)
{
	vec3 i = floor(p);
	vec3 f = fract(p);
	vec3 u = f * f * (3.0 - 2.0 * f);
	return mix(mix(mix(dot(hash_gradient_3d(i + vec3(0.0, 0.0, 0.0)), f - vec3(0.0, 0.0, 0.0)),
						   dot(hash_gradient_3d(i + vec3(1.0, 0.0, 0.0)), f - vec3(1.0, 0.0, 0.0)), u.x),
					   mix(dot(hash_gradient_3d(i + vec3(0.0, 1.0, 0.0)), f - vec3(0.0, 1.0, 0.0)),
						   dot(hash_gradient_3d(i + vec3(1.0, 1.0, 0.0)), f - vec3(1.0, 1.0, 0.0)), u.x),
					   u.y),
			mix(mix(dot(hash_gradient_3d(i + vec3(0.0, 0.0, 1.0)), f - vec3(0.0, 0.0, 1.0)),
						dot(hash_gradient_3d(i + vec3(1.0, 0.0, 1.0)), f - vec3(1.0, 0.0, 1.0)), u.x),
					mix(dot(hash_gradient_3d(i + vec3(0.0, 1.0, 1.0)), f - vec3(0.0, 1.0, 1.0)),
						dot(hash_gradient_3d(i + vec3(1.0, 1.0, 1.0)), f - vec3(1.0, 1.0, 1.0)), u.x),
					u.y),
			u.z);
}

float compute_wind(vec3 position, float time)
{
	position += time;
	position *= params.time_speed_randomness_wavesize.w;

	float waveoffset = 0.0;
	waveoffset += noise_gradient_3d(position);
	waveoffset += noise_gradient_3d(position / 2.0);
	waveoffset += noise_gradient_3d(position / 4.0);
	waveoffset += noise_gradient_3d(position / 8.0);
	waveoffset += noise_gradient_3d(position / 16.0);
	waveoffset += noise_gradient_3d(position / 32.0);
	waveoffset *= params.time_speed_randomness_wavesize.z;

	return sin(time * params.time_speed_randomness_wavesize.y + waveoffset);
}

void main()
{
	ivec3 texel = ivec3(gl_GlobalInvocationID);
	if (texel.x >= kSize || texel.y >= kSize || texel.z >= kSize) return;
	float value = compute_wind(vec3(texel), params.time_speed_randomness_wavesize.x);
	imageStore(wind_image, texel, vec4(value, 0.0, 0.0, 0.0));
}
