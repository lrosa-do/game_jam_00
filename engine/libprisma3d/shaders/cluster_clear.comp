#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std140) uniform Params {
	uint word_count;
	uint row_width;
	uint pad0;
	uint pad1;
}
params;

layout(set = 2, binding = 0, std430) buffer restrict writeonly ClusterClear {
	uint data[];
}
cluster_clear;

void main() {
	uint index = gl_GlobalInvocationID.y * params.row_width + gl_GlobalInvocationID.x;
	if (index >= params.word_count) {
		return;
	}
	cluster_clear.data[index] = 0;
}
