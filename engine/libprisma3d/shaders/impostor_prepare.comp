#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std140) uniform Params
{
    vec4 camera_position;
    vec4 planes[6];
    uint count;
    uint capacity;
    uint pad0;
    uint pad1;
}
params;

layout(set = 2, binding = 0, std430) buffer restrict readonly Instances
{
    vec4 data[];
}
instances;

layout(set = 2, binding = 1, std430) buffer Output
{
    uint data[];
}
output_buffer;

const float PI = 3.14159265359;
const uint IMPOSTOR_CAPTURE_ANGLES = 36u;
const uint HEADER_WORDS = 8u;

const vec2 BILLBOARD[4] = vec2[](vec2(-1.0, -1.0), vec2(1.0, -1.0), vec2(-1.0, 1.0), vec2(1.0, 1.0));

void main()
{
    uint instance_index = gl_GlobalInvocationID.x;
    if (instance_index >= params.count) return;

    vec4 first = instances.data[instance_index * 2u];
    vec4 second = instances.data[instance_index * 2u + 1u];
    vec3 center = first.xyz;
    float radius = first.w;
    float fade_distance = second.x;
    int slice_offset = floatBitsToInt(second.y);
    uint instance_color = floatBitsToUint(second.z);

    float dist = distance(params.camera_position.xyz, center);
    bool distance_culled = dist < (fade_distance - radius);

    bool in_frustum = true;
    for (int p = 0; p < 6; ++p)
    {
        in_frustum = in_frustum && dot(params.planes[p], vec4(center, 1.0)) > -radius;
    }

    bool visible = slice_offset >= 0 && !distance_culled && in_frustum;
    if (!visible) return;

    uint index_offset = atomicAdd(output_buffer.data[0], 6u);
    uint impostor_offset = index_offset / 6u;
    uint vertex_offset = impostor_offset * 4u;

    vec3 up = vec3(0.0, 1.0, 0.0);
    vec3 face = params.camera_position.xyz - center;
    face.y = 0.0;
    face = dot(face, face) > 1e-12 ? normalize(face) : vec3(0.0, 0.0, 1.0);
    vec3 right = normalize(cross(face, up));

    uint slice = uint(slice_offset);
    float angle = acos(clamp(dot(face.xz, vec2(0.0, 1.0)), -1.0, 1.0)) / PI;
    if (cross(face, vec3(0.0, 0.0, 1.0)).y < 0.0)
    {
        angle = 2.0 - angle;
    }
    angle *= 0.5;
    angle = clamp(angle - 0.0001, 0.0, 1.0);
    slice += uint(angle * float(IMPOSTOR_CAPTURE_ANGLES)) * 3u;

    float dither = max(0.0, fade_distance - dist) / radius;

    uint positions_base = HEADER_WORDS;
    uint normals_base = positions_base + params.capacity * 16u;
    uint data_base = normals_base + params.capacity * 16u;

    uint data_x = slice & 0xFFFFFFu;
    data_x |= (uint(dither * 255.0) & 0xFFu) << 24u;
    output_buffer.data[data_base + impostor_offset * 2u] = data_x;
    output_buffer.data[data_base + impostor_offset * 2u + 1u] = instance_color;

    for (uint vertex_id = 0u; vertex_id < 4u; ++vertex_id)
    {
        vec2 corner = BILLBOARD[vertex_id];
        vec3 pos = corner.x * right + corner.y * up;
        pos *= radius;
        pos += center;
        uint at = positions_base + (vertex_offset + vertex_id) * 4u;
        output_buffer.data[at + 0u] = floatBitsToUint(pos.x);
        output_buffer.data[at + 1u] = floatBitsToUint(pos.y);
        output_buffer.data[at + 2u] = floatBitsToUint(pos.z);
        output_buffer.data[at + 3u] = 0u;
        uint nat = normals_base + (vertex_offset + vertex_id) * 4u;
        output_buffer.data[nat + 0u] = floatBitsToUint(face.x);
        output_buffer.data[nat + 1u] = floatBitsToUint(face.y);
        output_buffer.data[nat + 2u] = floatBitsToUint(face.z);
        output_buffer.data[nat + 3u] = 0u;
    }
}
