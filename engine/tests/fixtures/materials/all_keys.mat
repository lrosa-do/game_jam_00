material "everything" {
    transparency     = Blend
    alpha_cutoff     = 0.25
    alpha_antialiasing = AlphaToCoverage
    alpha_antialiasing_edge = 0.6
    blend            = Screen
    cull             = Front
    depth_test       = false
    lit              = false
    color            = (0.1, 0.2, 0.3, 0.4)
    albedo           = "tex/albedo.png"
    metallic         = 0.75
    metallic_map     = "tex/metal.png"
    metallic_channel = Blue
    specular         = 0.25
    roughness        = 0.5
    roughness_map    = "tex/rough.png"
    roughness_channel = Green
    orm              = "tex/orm.png"
    occlusion        = "tex/ao.png"
    occlusion_channel = Alpha
    ao_light_affect  = 0.5
    refraction       = 0.3
    refraction_map   = "tex/refraction.png"
    refraction_channel = Green
    emission_color   = (1, 0.5, 0.25)
    emission_energy  = 4
    emission_operator = Multiply
    emission         = "tex/emission.png"
    normal           = "tex/normal.png"
    normal_scale     = -2
    clearcoat        = 0.75
    clearcoat_roughness = 0.125
    clearcoat_map    = "tex/coat.png"
    uv1_scale        = (2, 3, 4)
    uv1_offset       = (0.5, 0.25, 0.125)
    uv2_scale        = (3, 2, 1.5)
    uv2_offset       = (0.75, 0.5, 0.25)
    detail           = true
    detail_albedo    = "tex/detail_albedo.png"
    detail_normal    = "tex/detail_normal.png"
    detail_mask      = "tex/detail_mask.png"
    detail_blend     = Multiply
    detail_uv        = Uv2
    billboard        = FixedY
    billboard_keep_scale = true
    receive_shadows  = false
    backlight        = (0.5, 0.25, 0.125)
    grass            = true
    grass_draw_distance = 90
    grass_camera_bend = 0.25
    grass_tint_a     = (0.5, 0.5, 0.25)
    grass_tint_b     = (1, 0.5, 0.5)
    grass_wind_direction = (0, 0, 1)
    grass_wind_amplitude = 0.5
    grass_wind_speed = 2
    leaf_wind        = true
    leaf_wind_direction = (0, 0, 1)
    leaf_wind_strength = 0.5
    leaf_wind_speed  = 2
    leaf_wind_height = 12
    terrain_morph    = true
    water            = true
    water_wind_direction = (1, 0.5)
    water_wind_speed = 2
    water_waves_big  = (0.5, 0.4)
    water_waves_mid  = (0.25, 0.2)
    water_waves_small = (0.125, 0.0625)
    water_wave_scale = 10
    water_wave_chop  = 0.5
    water_bump       = 2
    water_bump2      = 4
    water_specular_mix = 0.75
    water_depth_fade = (0.1, 0.05, 0.025)
    water_depth_scale = 1.5
    water_shore_fade = 8
}

material "plain" {
    color            = (0.75, 0.75, 0.75, 1)
    roughness        = 0.9
}
